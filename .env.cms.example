# Content CMS admin (required for /admin/content mutations)
CONTENT_ADMIN_EMAIL=editor@example.com
# Prefer a hash from: npx tsx scripts/hash-content-admin-password.ts 'your-password'
CONTENT_ADMIN_PASSWORD_HASH=
# Local/dev only — ignored in production when hash is unset
CONTENT_ADMIN_PASSWORD=change-me-locally
CONTENT_ADMIN_SESSION_SECRET=replace-with-32-plus-char-random-secret

# CMS persistence
# Development: memory | file | upstash
# Production: MUST be upstash with Upstash credentials (file/memory are rejected)
CMS_STORE=file
CMS_DATABASE_PATH=data/cms/content-store.json

# Required in production (durable CMS store)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
