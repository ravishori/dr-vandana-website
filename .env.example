# Ask Dr. Vandana AI
# Server-only. Never prefix these with NEXT_PUBLIC_.

AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DATABASE_URL=
MAX_QUESTION_LENGTH=2000
MAX_TOKENS=700
RATE_LIMIT_PER_MINUTE=12

# Psychologist question portal
# Generate PSYCHOLOGIST_PASSWORD_HASH with:
# npx tsx scripts/hash-psychologist-password.ts 'your-long-password'
PSYCHOLOGIST_LOGIN_EMAIL=
PSYCHOLOGIST_PASSWORD_HASH=
SESSION_SECRET=
QUESTION_NOTIFICATION_EMAIL=
APP_BASE_URL=https://drvandana.trinetralab.net
QUESTION_STORE=auto
QUESTION_DATABASE_PATH=data/question-portal.sqlite
QUESTION_MAX_LENGTH=4000

# Appointment enquiry + identity SMTP (server-only). Never commit passwords.
# Canonical names (preferred):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dr. Vandana Rajiv Chaudhary Website
# Gmail-friendly aliases (optional; same meaning as HOST/USER/FROM):
# SMTP_SERVER=smtp.gmail.com
# SMTP_EMAIL=
# SMTP_PASSWORD must be a Gmail App Password when using smtp.gmail.com — never the normal Gmail password.
APPOINTMENT_TO_EMAIL=

# Shared with appointment abuse prevention (production/staging should use upstash)
# APPOINTMENT_RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Crisis / emergency helpline directory
# Uses the same Upstash credentials when available.
CRISIS_STORE=auto
CRISIS_DATABASE_PATH=data/crisis-resources.sqlite

# Optional operational error-alert email (server-only)
# ERROR_NOTIFY_EMAIL=
# ERROR_EMAIL_ENABLED=true
# ERROR_EMAIL_MIN_SEVERITY=ERROR
# ERROR_EMAIL_COOLDOWN_SECONDS=300

# Phase 1–2A identity foundation (server-only). Never prefix with NEXT_PUBLIC_.
# Never commit secrets. Staging/production values belong only in the host secret store.
# Patient registration stays disabled until security gates are green.
# Operator snapshots: npm run identity:gates | npm run production:gates | npm run db:verify-production
DATABASE_URL=
AUTH_SESSION_SECRET=
MFA_ENCRYPTION_KEY=
# OTP_PROVIDER=twilio for Twilio SMS (phone OTP). test/mock/dev forbidden in production.
OTP_PROVIDER=
OTP_API_KEY=
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
PATIENT_REGISTRATION_ENABLED=false
IDENTITY_PROVISION_ENABLED=false
EMAIL_PROVIDER=smtp

# Phase 2A Twilio SMS OTP (server-only). Distinct from WhatsApp.
# Canonical sender: TWILIO_FROM_NUMBER (E.164). Alias: TWILIO_PHONE_NUMBER.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_PHONE_NUMBER=

# Phase 2F appointment notifications (server-only). Never prefix with NEXT_PUBLIC_.
# Production WhatsApp stays disabled until Twilio sender, templates, opt-in
# legal review, and secrets are approved. Do not treat sandbox as production.
# WHATSAPP_PROVIDER=twilio
WHATSAPP_PROVIDER=
TWILIO_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_SANDBOX=false
# Content SIDs live only in the Twilio adapter. Leave empty until templates are approved.
TWILIO_TEMPLATE_APPOINTMENT_REQUESTED=
TWILIO_TEMPLATE_APPOINTMENT_REQUESTED_PSYCHOLOGIST=
TWILIO_TEMPLATE_APPOINTMENT_CONFIRMED=
TWILIO_TEMPLATE_APPOINTMENT_REJECTED=
TWILIO_TEMPLATE_APPOINTMENT_CANCELLED=
TWILIO_TEMPLATE_APPOINTMENT_CANCELLED_PSYCHOLOGIST=
TWILIO_TEMPLATE_APPOINTMENT_RESCHEDULE_REQUESTED=
TWILIO_TEMPLATE_APPOINTMENT_RESCHEDULE_REQUESTED_PSYCHOLOGIST=
TWILIO_TEMPLATE_APPOINTMENT_RESCHEDULED=
TWILIO_TEMPLATE_APPOINTMENT_COMPLETED=
TWILIO_TEMPLATE_APPOINTMENT_NO_SHOW=
# Configurable dispatcher defaults. Production values remain OPEN.
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_LEASE_MS=120000
# NOTIFICATION_BATCH_SIZE=20
# NOTIFICATION_PROVIDER_TIMEOUT_MS=15000
# NOTIFICATION_BACKOFF_MS=60000,300000,900000,3600000,14400000
# NOTIFICATION_EXPAND_BATCH_SIZE=50
# NOTIFICATION_COMPLETED_EMAIL=false
# NOTIFICATION_NO_SHOW_EMAIL=false
# PROVISION_ROLE=
# PROVISION_EMAIL=
# PROVISION_PASSWORD=
# PROVISION_DISPLAY_NAME=
# PROVISION_MOBILE=
# APPLY_IDENTITY_MIGRATION=false
