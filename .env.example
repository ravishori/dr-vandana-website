# Ask Dr. Vandana AI
# Server-only. Never prefix these with NEXT_PUBLIC_.

AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DATABASE_URL=
MAX_QUESTION_LENGTH=2000
MAX_TOKENS=700
RATE_LIMIT_PER_MINUTE=12

# Psychologist question portal
# Generate PSYCHOLOGIST_PASSWORD_HASH with:
# npx tsx scripts/hash-psychologist-password.ts 'your-long-password'
PSYCHOLOGIST_LOGIN_EMAIL=
PSYCHOLOGIST_PASSWORD_HASH=
SESSION_SECRET=
QUESTION_NOTIFICATION_EMAIL=
APP_BASE_URL=https://drvandana.trinetra.net
QUESTION_STORE=auto
QUESTION_DATABASE_PATH=data/question-portal.sqlite
QUESTION_MAX_LENGTH=4000

# Appointment enquiry + question-portal SMTP (server-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dr. Vandana Rajiv Chaudhary Website
APPOINTMENT_TO_EMAIL=

# Shared with appointment abuse prevention (production should use upstash)
# APPOINTMENT_RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Crisis / emergency helpline directory
# Uses the same Upstash credentials when available.
CRISIS_STORE=auto
CRISIS_DATABASE_PATH=data/crisis-resources.sqlite

# Optional operational error-alert email (server-only)
# ERROR_NOTIFY_EMAIL=
# ERROR_EMAIL_ENABLED=true
# ERROR_EMAIL_MIN_SEVERITY=ERROR
# ERROR_EMAIL_COOLDOWN_SECONDS=300

# Phase 1 identity foundation (server-only). Never prefix with NEXT_PUBLIC_.
# PRODUCTION PROVIDER CONFIGURATION REQUIRED for PostgreSQL and OTP.
# Patient registration is not production-ready until gates in
# docs/PHASE_1_IMPLEMENTATION.md and docs/PHASE_1C_PRODUCTION_GATE_REGISTER.md
# are satisfied. Operator YES/NO snapshot: npm run identity:gates
# (never prints secret values; not a public route).
DATABASE_URL=
AUTH_SESSION_SECRET=
MFA_ENCRYPTION_KEY=
OTP_PROVIDER=
OTP_API_KEY=
PATIENT_REGISTRATION_ENABLED=false
IDENTITY_PROVISION_ENABLED=false
EMAIL_PROVIDER=smtp
# PROVISION_ROLE=
# PROVISION_EMAIL=
# PROVISION_PASSWORD=
# PROVISION_DISPLAY_NAME=
# PROVISION_MOBILE=
# APPLY_IDENTITY_MIGRATION=false
