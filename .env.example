# Ask Dr. Vandana AI
# Server-only. Never prefix these with NEXT_PUBLIC_.

AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DATABASE_URL=
MAX_QUESTION_LENGTH=2000
MAX_TOKENS=700
RATE_LIMIT_PER_MINUTE=12

# Psychologist question portal
# Generate PSYCHOLOGIST_PASSWORD_HASH with:
# npx tsx scripts/hash-psychologist-password.ts 'your-long-password'
PSYCHOLOGIST_LOGIN_EMAIL=
PSYCHOLOGIST_PASSWORD_HASH=
SESSION_SECRET=
QUESTION_NOTIFICATION_EMAIL=
APP_BASE_URL=https://drvandana.trinetra.net
QUESTION_STORE=auto
QUESTION_DATABASE_PATH=data/question-portal.sqlite
QUESTION_MAX_LENGTH=4000

# Shared with appointment abuse prevention (production should use upstash)
# APPOINTMENT_RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# SMTP (appointment enquiry + question portal + error alerts)
# Required for email delivery. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Dr. Vandana Website
APPOINTMENT_TO_EMAIL=
# QUESTION_NOTIFICATION_EMAIL can also receive portal alerts (already listed above)

# Optional error-alert email tuning
# ERROR_NOTIFY_EMAIL=
# ERROR_EMAIL_ENABLED=false
# ERROR_EMAIL_MIN_SEVERITY=ERROR
# ERROR_EMAIL_COOLDOWN_SECONDS=300

# Crisis / emergency helpline directory
# Uses the same Upstash credentials when available.
CRISIS_STORE=auto
CRISIS_DATABASE_PATH=data/crisis-resources.sqlite

# ---------------------------------------------------------------------------
# Patient & Practice Management System
# See docs/patient-practice-management-architecture-review.md
# OTP SMS + WhatsApp Business API are MOCKED until provider keys are set.
# ---------------------------------------------------------------------------
PRACTICE_STORE=sqlite
PRACTICE_DATABASE_PATH=data/practice-management.sqlite
PRACTICE_DOCUMENT_DIR=data/practice-documents
# Prefer a dedicated secret; falls back to SESSION_SECRET if unset.
PRACTICE_SESSION_SECRET=
OTP_PROVIDER=mock
# OTP_API_KEY=
WHATSAPP_PROVIDER=mock
# WHATSAPP_API_KEY=
MFA_ISSUER=Dr Vandana Portal
# PRACTICE_RATE_LIMIT_MAX=30
