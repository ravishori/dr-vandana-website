# Ask Dr. Vandana AI
# Server-only. Never prefix these with NEXT_PUBLIC_.

AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DATABASE_URL=
MAX_QUESTION_LENGTH=2000
MAX_TOKENS=700
RATE_LIMIT_PER_MINUTE=12

# Shared with appointment abuse prevention (production should use upstash)
# APPOINTMENT_RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Doctor portal (server-only)
# Generate password hash: npx tsx scripts/hash-doctor-password.ts "your-password"
DOCTOR_LOGIN_EMAIL=
DOCTOR_PASSWORD_HASH=
DOCTOR_SESSION_SECRET=
# DOCTOR_PASSWORD=   # non-production only; ignored when DOCTOR_PASSWORD_HASH is set

# Articles store: memory | file | upstash (production must use upstash)
# ARTICLES_STORE=file
# ARTICLES_DATABASE_PATH=data/articles/articles-store.json

# Communications store: memory | file | upstash (production must use upstash)
# COMMUNICATIONS_STORE=file
# COMMUNICATIONS_DATABASE_PATH=data/communications/communications-store.json

# Optional absolute site URL for portal email links
# APP_BASE_URL=https://drvandana.trinetralab.net

# Appointment SMTP (existing)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=
# APPOINTMENT_TO_EMAIL=
